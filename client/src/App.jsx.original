// WARNING POPUP
function LoginWarning({ user, onClose, onLogin, onRegister }) {
  const isLoggedIn = Boolean(user);

  return (
    <div className="warning-overlay" onClick={onClose}>
      <div
        className="warning-modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="warning-title"
        onClick={(event) => event.stopPropagation()}
      >
        <button
          type="button"
          className="warning-close"
          onClick={onClose}
          aria-label="Close"
        >
          ×
        </button>

        <div className="warning-icon">!</div>

        <h2 id="warning-title">
          {isLoggedIn ? "Provider account required" : "Login required"}
        </h2>

        <p>
          {isLoggedIn
            ? "Your current account does not have provider access. You need a Provider account to list your parking space."
            : "Please log in or create an account before listing your parking space on Parkly."}
        </p>

        {!isLoggedIn && (
          <div className="warning-actions">
            <button
              type="button"
              className="warning-login"
              onClick={onLogin}
            >
              Log In
            </button>

            <button
              type="button"
              className="warning-register"
              onClick={onRegister}
            >
              Create Account
            </button>
          </div>
        )}

        <button
          type="button"
          className="warning-cancel"
          onClick={onClose}
        >
          Maybe later
        </button>
      </div>
    </div>
  );
}

// APP CONTENT - INSIDE BROWSER ROUTER
function AppContent({
  user,
  setUser,
  onLogout,
  showLoginWarning,
  setShowLoginWarning,
}) {
  const navigate = useNavigate();

  const handleListSpace = () => {
    if (!user) {
      setShowLoginWarning(true);
      return;
    }

    if (user.role === "PROVIDER" || user.role === "BOTH") {
      navigate("/provider");
    } else {
      setShowLoginWarning(true);
    }
  };
  const handleAccessDenied = useCallback(() => {
    setShowLoginWarning(true);
  }, [setShowLoginWarning]);

  return (
    <>
      <Navbar
        user={user}
        onLogout={onLogout}
        onListSpace={handleListSpace}
        onOpenLogin={() => navigate("/login")}
      />

      <Routes>
        <Route
          path="/"
          element={<HomePage onListSpace={handleListSpace} />}
        />

        <Route
          path="/find-parking"
          element={<DriverPage />}
        />

        <Route
          path="/provider"
          element={
            <ProtectedProviderRoute
              user={user}
              onAccessDenied={handleAccessDenied}
            />
          }
        />

        <Route
          path="/login"
          element={<LoginPage onLogin={setUser} />}
        />

        <Route
          path="/register"
          element={<RegisterPage />}
        />
      </Routes>

      <Footer onListSpace={handleListSpace} />

      {showLoginWarning && (
        <LoginWarning
          user={user}
          onClose={() => setShowLoginWarning(false)}
          onLogin={() => {
            setShowLoginWarning(false);
            navigate("/login");
          }}
          onRegister={() => {
            setShowLoginWarning(false);
            navigate("/register");
          }}
        />
      )}
    </>
  );
}

// MAIN APP
function App() {
  const [user, setUser] = useState(null);
  const [authLoading, setAuthLoading] = useState(true);
  const [showLoginWarning, setShowLoginWarning] = useState(false);

  // RESTORE LOGIN SESSION
  useEffect(() => {
    const checkSession = async () => {
      try {
        const response = await fetch(`${API_URL}/me`, {
          credentials: "include",
        });

        const result = await response.json();

        if (response.ok && result.success) {
          setUser(result.user);
        } else {
          setUser(null);
        }
      } catch (error) {
        console.error("Session check failed:", error);
        setUser(null);
      } finally {
        setAuthLoading(false);
      }
    };

    checkSession();
  }, []);

  // LOGOUT
  const handleLogout = async () => {
    const response = await fetch(`${API_URL}/logout`, {
      method: "POST",
      credentials: "include",
    });

    const result = await response.json();

    if (!response.ok || !result.success) {
      throw new Error(result.message || "Logout failed.");
    }

    setUser(null);
  };

  if (authLoading) {
    return <p>Loading Parkly...</p>;
  }

  return (
    <BrowserRouter>
      <AppContent
        user={user}
        setUser={setUser}
        onLogout={handleLogout}
        showLoginWarning={showLoginWarning}
        setShowLoginWarning={setShowLoginWarning}
      />
    </BrowserRouter>
  );
}

export default App;