generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  DRIVER
  PROVIDER
  BOTH
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum EmailJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String?
  role         UserRole @default(DRIVER)

  parkingSpaces ParkingSpace[]
  bookings      Booking[]

  createdAt DateTime @default(now())
}

model ParkingSpace {
  id           Int    @id @default(autoincrement())
  name         String
  address      String
  area         String
  pricePerHour Float

  covered    Boolean @default(false)
  evCharging Boolean @default(false)
  access24x7 Boolean @default(false)
  available  Boolean @default(true)

  latitude     Float?
  longitude    Float?
  contactPhone String?

  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id])

  bookings Booking[]

  createdAt DateTime @default(now())
}

model Booking {
  id Int @id @default(autoincrement())

  userId         Int
  parkingSpaceId Int

  // Existing booking fields
  bookingDate   DateTime
  startTime     String
  durationHours Int
  totalPrice    Float

  // Exact booking time interval
  startAt DateTime?
  endAt   DateTime?

  // Booking and payment status
  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  // Amount in paise (₹1 = 100 paise)
  amountPaise Int?

  // Razorpay payment references
  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique

  user         User         @relation(fields: [userId], references: [id])
  parkingSpace ParkingSpace @relation(fields: [parkingSpaceId], references: [id])

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  expiresAt DateTime?
  emailJobs EmailJob[]

  // Razorpay refund references
  razorpayRefundId  String?       @unique
  refundStatus      RefundStatus?
  refundAmountPaise Int?
  refundProcessedAt DateTime?

  @@index([userId])
  @@index([parkingSpaceId, status, startAt, endAt])
  @@index([paymentStatus])
}

model EmailJob {
  id Int @id @default(autoincrement())

  bookingId Int?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  recipient String
  subject   String
  html      String @db.Text

  status   EmailJobStatus @default(PENDING)
  attempts Int            @default(0)

  nextRetryAt DateTime  @default(now())
  lockedAt    DateTime?
  lastError   String?   @db.Text
  sentAt      DateTime?

  // Prevent duplicate confirmation emails
  dedupeKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextRetryAt])
  @@index([bookingId])
}
